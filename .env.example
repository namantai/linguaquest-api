# Copy to .env. Supply your own values; no working secrets are checked in.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=linguaquest
POSTGRES_USER=linguaquest
POSTGRES_PASSWORD=
# Compose service names. Use localhost when running Python on the host.
POSTGRES_HOST=db
POSTGRES_PORT=5432
CELERY_BROKER_URL=redis://redis:6379/0
# disabled (default), openai (real paid calls), or mock (explicit local demo)
AI_FEEDBACK_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
